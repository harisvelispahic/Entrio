# =============================================================================
# Entrio — configuration template. TRACKED in git. Never put real values here.
#
# Copy to ".env" in this same folder and fill in real values:
#     cp .env.example .env
#
# This one file feeds BOTH run modes:
#   docker compose up   -> compose reads these and passes Section__Key names to the API
#   dotnet run / VS     -> DotNetEnv reads this file and the alias map in
#                          IoT.API/Configuration/EnvironmentConfiguration.cs converts
#                          the plain names below into the Section__Key names ASP.NET binds.
#
# Adding a new secret means touching THREE places together:
#   1. .env.example          (this file — placeholder + comment)
#   2. EnvironmentConfiguration.Aliases   (plain name -> Section__Key)
#   3. docker-compose.yml environment:    (the same Section__Key)
# =============================================================================

# --- Database -----------------------------------------------------------------
# SQL Server rejects weak passwords: 8+ chars with upper, lower, digit and symbol.
# WARNING: SQL Server only applies this password when its data volume is FIRST
# created. Changing it later has no effect until "docker compose down -v", which
# destroys the database.
MSSQL_SA_PASSWORD=ReplaceWithAStrongPassword1!

# --- API ----------------------------------------------------------------------
# Signing key for JWTs. Must be at least 32 characters (HMAC-SHA256).
# Generate one with:  openssl rand -base64 48
# -> aliased onto Jwt__Key
JWT_KEY=replace-with-at-least-32-random-characters

# --- Seed credentials ---------------------------------------------------------
# Used once, on first startup against an empty database, to create the owner
# account and the ESP32 device row. Stored only as salted hashes.
# Changing these later does NOT update existing rows — reseed with
# "docker compose down -v" or by deleting the rows.
# -> aliased onto Seed__OwnerEmail / Seed__OwnerPin / Seed__DeviceKey
OWNER_EMAIL=you@example.com
OWNER_PIN=replace-with-your-login-pin

# Shared secret the ESP32 sends as the X-Device-Key header.
# The identical value must go into Esp32.IoT/secrets.h (see secrets.example.h).
DEVICE_KEY=replace-with-a-long-random-device-key

# --- Frontend (public — these are served to the browser in env.js) ------------
# Must be reachable FROM THE BROWSER, so it is a host address, never a compose
# service name: the fetch runs on your machine, outside the Docker network.
# Only put PUBLIC values here; env.js is downloaded by every visitor.
API_BASE_URL=http://localhost:5263/api

# =============================================================================
# Local (non-Docker) runs — only what differs from the container
#
# These are explicit Section__Key names, not plain names, because they are
# host-dependent and therefore cannot be aliased: one plain name cannot hold
# two values. Inside the container compose supplies the container-side value.
# =============================================================================

# Container uses Server=entrio-sqlserver,1433 — the compose service name.
# Local runs reach the SAME Docker database through its published host port 1437,
# so no locally installed SQL Server is required.
# The password here must match MSSQL_SA_PASSWORD above.
ConnectionStrings__DefaultConnection=Server=localhost,1437;Database=GarageIoT;User Id=sa;Password=ReplaceWithAStrongPassword1!;TrustServerCertificate=True;MultipleActiveResultSets=true
